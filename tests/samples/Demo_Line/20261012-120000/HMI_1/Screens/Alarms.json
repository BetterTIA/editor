      "height": 56,
      "visible": true,
      "enabled": true,
      "layer": 0,
      "tabIndex": 2,
      "text": {
        "$type": "MultilingualText",
        "items": [
          {
            "$type": "MultilingualTextItem",
            "language": "en-US",
            "text": "Acknowledge"
          }
        ]
      },
      "backColor": "#FF2F6FA3",
      "foreColor": "#FFFFFFFF",
      "borderColor": "#FF1F3A5F",
      "borderWidth": 1,
      "cornerRadius": 4,
      "font": {
        "$type": "HmiFontPart",
        "name": "Siemens Sans",
        "size": 18,
        "weight": "Bold",
        "italic": false,
        "underline": false
      },
      "eventHandlers": [
        {
          "$type": "EventHandler",
          "eventType": "Tapped",
          "script": {
            "$type": "Script",
            "scriptCode": "HMIRuntime.Alarming.SysFct.AcknowledgeAlarms();",
            "async": false
          }
        }
      ]
