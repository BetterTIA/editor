          "script": {
            "$type": "Script",
            "scriptCode": "HMIRuntime.UI.SysFct.ChangeScreen(\"Overview\", \"../\");",
            "async": false
          }
        }
      ]
    },
    {
      "$type": "HmiButton",
      "name": "Btn_Ack",
      "left": 1056,
