{
  "$type": "HmiScreen",
  "name": "Alarms",
  "width": 1280,
  "height": 800,
  "backColor": "#FFEEF1F4",
  "screenNumber": 0,
  "screenItems": [
    {
      "$type": "HmiRectangle",
      "name": "Header",
      "left": 0,
      "top": 0,
      "width": 1280,
      "height": 64,
      "visible": true,
      "enabled": true,
      "layer": 0,
      "tabIndex": 0,
      "backColor": "#FF1F3A5F",
      "borderColor": "#FF1F3A5F",
      "borderWidth": 0
