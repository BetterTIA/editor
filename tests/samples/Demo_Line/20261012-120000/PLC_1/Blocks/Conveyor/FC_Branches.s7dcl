{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "LAD";
    S7_BlockNumber := "20";
    S7_Version := "0.1"
}
FUNCTION "FC_Branches" : Void
    VAR_TEMP
        Aux : Int;
    END_VAR

    {
        S7_Language := "LAD";
        S7_NetworkTitle := "MLC_1"
    }
    NETWORK
        RUNG wire#powerrail
            Contact( "Sensor_A" )
            wire#w1
            Contact( "Sensor_B" )
            wire#w2
            Coil( "Output_1" )
        END_RUNG
        RUNG wire#w1
            Contact( "Sensor_C" )
        END_RUNG wire#w2
        RUNG wire#powerrail
            Contact( "Button_1" )
            I_Contact( "Button_2" )
        END_RUNG wire#w1
    END_NETWORK
    {
        S7_Language := "LAD";
        S7_NetworkTitle := "MLC_2"
    }
    NETWORK
        RUNG wire#powerrail
            Contact( "Cycle_Start" )
            wire#w1
            Coil( "Cycle_Running" )
        END_RUNG
        RUNG wire#w1
            Move(
                in := 0,
                out1 => #Aux
            )
        END_RUNG
        RUNG wire#w1
            I_Contact( "Door_Closed" )
            R_Coil( "Enable_Manual" )
        END_RUNG
    END_NETWORK
    {
        S7_Language := "FBD";
        S7_NetworkTitle := "MLC_3"
    }
    NETWORK
        RUNG "Sensor_A"
            O( in2 := "Sensor_B" )
            Coil( "Output_2" )
        END_RUNG
    END_NETWORK
    {
        S7_Language := "LAD";
        S7_NetworkTitle := "MLC_4"
    }
    NETWORK
        RUNG wire#powerrail
            Contact( "M_1" )
            wire#w1
            Contact( "M_2" )
            wire#w3
            Coil( "Bridge" )
        END_RUNG
        RUNG wire#powerrail
            Contact( "M_3" )
            wire#w2
            Contact( "M_4" )
        END_RUNG wire#w3
        RUNG wire#w1
            Contact( "M_5" )
        END_RUNG wire#w2
    END_NETWORK
    {
        S7_Language := "LAD";
        S7_NetworkTitle := "MLC_5"
    }
    NETWORK
        RUNG wire#powerrail
            Contact( "Clock" )
            
            Move(
                in := #Aux,
                out1 => "DB_Machine".Copy
            )
            { S7_Templates := "SrcType := Int" }
            Add(
                in1 := #Aux,
                in2 := 1,
                out => #Aux
            )
        END_RUNG
        RUNG wire#powerrail
            Contact( "Sensor_C" )
            { S7_Templates := "time_type := Time" }
            "DB_T_Rundown".TOF(
                pt := T#500ms,
                et =>  
            )
            Coil( "Rundown" )
        END_RUNG
    END_NETWORK
END_FUNCTION
