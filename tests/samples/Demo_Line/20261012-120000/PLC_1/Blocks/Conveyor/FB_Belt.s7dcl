{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "LAD";
    S7_BlockNumber := "11";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "FB_Belt"
    VAR_INPUT
        Enable : Bool;
        Direction : Bool;
        Speed : Real;
        Reset : Bool;
    END_VAR
    VAR_OUTPUT
        Running : Bool;
        Fault : Bool;
        State : Int;
    END_VAR

    {
        S7_Language := "LAD";
        S7_NetworkTitle := "MLC_1"
    }
    NETWORK
        RUNG wire#powerrail
            Contact( #Enable )
            I_Contact( #Fault )
            Coil( #Running )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
