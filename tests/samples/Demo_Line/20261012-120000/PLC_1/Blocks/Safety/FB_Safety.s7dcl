{
    S7_BlockNumber := "30";
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "FBD";
    S7_Safety := "TRUE";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "FB_Safety"
    VAR_INPUT
        Start : Bool;
        Service : Bool;
        Fault : Bool;
        Ack_Button : Bool;
        Ack_HMI : Bool;
        Ack_Remote : Bool;
        Door_Closed : Bool;
        Lock_OK : Bool;
        Detector_A : Bool;
        Detector_B : Bool;
    END_VAR
    VAR_OUTPUT
        Enable : Bool;
        EStop_OK : Bool;
        Guard_OK : Bool;
    END_VAR
    VAR
        EStop : ESTOP1;
        Door : SFDOOR;
        Lockout : Bool;
        Ack : Bool;
        Ack_Mem : Bool;
        Ack_Required : Bool;
        Ack_Request : Bool;
        Lamp_Green : Bool;
        Lamp_Red : Bool;
        Fault_Mem : Bool;
        Mem_SR : Bool;
        State_SR : Bool;
        Clear : Bool;
        Always_1 : Bool;
        Step : Int;
        Mismatch_Mem : Bool;
        Mismatch_Edge : Bool;
    END_VAR

    {
        S7_Language := "FBD";
        S7_NetworkTitle := "MLC_1"
    }
    NETWORK
        RUNG #Start
            O( in2 := #Service )
            A(
                in2 := NOT #Fault,
                in3 := "DB_Machine".Safety_OK
            )
            Coil( #Enable )
        END_RUNG
    END_NETWORK
    {
        S7_Language := "FBD";
        S7_NetworkTitle := "MLC_2"
    }
    NETWORK
        RUNG #Ack_Button
            A( in2 := wire#w1 )
            Coil( #Ack )
        END_RUNG
        RUNG #Ack_HMI
            O(
                in2 := #Ack_Remote,
                in3 := NOT #Lockout
            )
        END_RUNG wire#w1
    END_NETWORK
    {
        S7_Language := "FBD";
        S7_NetworkTitle := "MLC_3"
    }
    NETWORK
        RUNG #Door_Closed
            A( in2 := #Lock_OK )
            wire#w2
            Coil( #Guard_OK )
            Coil( #Lamp_Green )
        END_RUNG
        RUNG wire#w2
            NOT Coil( #Lamp_Red )
        END_RUNG
    END_NETWORK
    {
        S7_Language := "FBD";
        S7_NetworkTitle := "MLC_4"
    }
    NETWORK
        RUNG
            {
                f_user_card := "1";
                f_image_card := "0"
            }
            #EStop.ESTOP1(
                E_STOP := "Emergency_Stop",
                ACK_NEC := NOT #Ack_Required,
                ACK := wire#w1,
                TIME_DEL :=  ,
                Q => #EStop_OK,
                Q_DELAY =>  ,
                ACK_REQ => #Ack_Request,
                DIAG =>
            )
        END_RUNG
        RUNG #Ack
            P_Trig( #Ack_Mem )
        END_RUNG wire#w1
    END_NETWORK
    {
        S7_Language := "FBD";
        S7_NetworkTitle := "MLC_5"
    }
    NETWORK
        RUNG
            {
                f_user_card := "1";
                f_image_card := "0"
            }
            #Door.SFDOOR(
                IN1 := "Door_K1",
                IN2 := "Door_K2",
                QBAD_IN1 := NOT "Module_K1".QBAD,
                QBAD_IN2 := NOT "Module_K2".QBAD,
                OPEN_NEC := #Ack_Required,
                ACK_NEC := #Ack_Required,
                ACK := #Ack,
                Q =>  ,
                ACK_REQ =>  ,
                DIAG =>
            )
        END_RUNG
    END_NETWORK
    {
        S7_Language := "FBD";
        S7_NetworkTitle := "MLC_6"
    }
    NETWORK
        RUNG #Fault
            S_Coil( #Fault_Mem )
        END_RUNG
        RUNG #Ack
            R_Coil( #Fault_Mem )
        END_RUNG
        RUNG #Fault_Mem
            S_SR(
                r1 := #Clear,
                operand := #Mem_SR
            )
            Coil( #State_SR )
        END_RUNG
    END_NETWORK
    {
        S7_Language := "FBD";
        S7_NetworkTitle := "MLC_7"
    }
    NETWORK
        RUNG true
            Coil( #Always_1 )
        END_RUNG
        RUNG TRUE
            Move(
                in := 1,
                out1 => #Step
            )
        END_RUNG
    END_NETWORK
    {
        S7_Language := "FBD";
        S7_NetworkTitle := "MLC_8"
    }
    NETWORK
        RUNG #Detector_A
            X( in2 := #Detector_B )
            N_Trig( #Mismatch_Mem )
            Coil( #Mismatch_Edge )
        END_RUNG
    END_NETWORK
    {
        S7_Language := "FBD"
    }
    NETWORK
        RUNG
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
